    <!-- Scripts (Battery Simulation & 3D Model) -->
    <script>
        /**
         * 1. BATTERY SIMULATION LOGIC
         */
        const batterySim = {
            maxCapacity: 2000,
            currentCapacity: 1000,
            maxVoltage: 8.4,
            minVoltage: 6.0,
            nominalVoltage: 7.4,
            baseTemp: 25.0,
            currentTemp: 25.0,
            chargeRate: 15,     // mAh per tick
            dischargeRate: 20,  // mAh per tick
            state: 'idle',      // 'idle', 'charging', 'discharging'
            currentDraw: 0,
            
            getVoltage: function() {
                const percentage = this.currentCapacity / this.maxCapacity;
                const v = this.minVoltage + (percentage * (this.maxVoltage - this.minVoltage));
                return v.toFixed(2);
            },
            
            getPercentage: function() {
                return ((this.currentCapacity / this.maxCapacity) * 100).toFixed(1);
            },
            
            tick: function() {
                if (this.state === 'charging') {
                    this.currentDraw = -2.0; 
                    if (this.currentCapacity < this.maxCapacity) {
                        this.currentCapacity += this.chargeRate;
                        this.currentTemp = Math.min(this.currentTemp + 0.15, 35.0); 
                    } else {
                        this.currentCapacity = this.maxCapacity;
                        this.state = 'idle'; 
                    }
                } else if (this.state === 'discharging') {
                    this.currentDraw = 3.5; 
                    if (this.currentCapacity > 0) {
                        this.currentCapacity -= this.dischargeRate;
                        this.currentTemp = Math.min(this.currentTemp + 0.25, 48.0); 
                    } else {
                        this.currentCapacity = 0;
                        this.state = 'idle';
                    }
                } else {
                    this.currentDraw = 0.0;
                    if (this.currentTemp > this.baseTemp) {
                        this.currentTemp -= 0.2;
                    }
                    if (this.currentTemp < this.baseTemp) this.currentTemp = this.baseTemp;
                }
                
                updateUI();
            }
        };

        /**
         * 2. UI UPDATE LOGIC
         */
        const uiVoltage = document.getElementById('ui-voltage');
        const uiCapacity = document.getElementById('ui-capacity');
        const uiPercentage = document.getElementById('ui-percentage');
        const uiTemp = document.getElementById('ui-temp');
        const uiCurrent = document.getElementById('ui-current');
        const batteryFill = document.getElementById('battery-fill');
        const statusText = document.getElementById('status-text');
        const statusDot = document.getElementById('status-dot');

        let bmsIndicatorMaterial; // Defined globally for 3D sync

        function updateUI() {
            uiVoltage.innerText = batterySim.getVoltage();
            uiCapacity.innerText = Math.round(batterySim.currentCapacity);
            const perc = batterySim.getPercentage();
            uiPercentage.innerText = `${perc}%`;
            batteryFill.style.width = `${perc}%`;
            uiTemp.innerText = batterySim.currentTemp.toFixed(1);
            uiCurrent.innerText = Math.abs(batterySim.currentDraw).toFixed(1);

            if (batterySim.state === 'charging') {
                statusText.innerText = 'กำลังชาร์จ...';
                statusText.className = 'text-xs font-bold tracking-wider uppercase text-green-400';
                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_8px_#22c55e] animate-pulse';
                batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-green-500';
                if(bmsIndicatorMaterial) bmsIndicatorMaterial.color.setHex(0x00ff00);
            } else if (batterySim.state === 'discharging') {
                statusText.innerText = 'กำลังจ่ายไฟ';
                statusText.className = 'text-xs font-bold tracking-wider uppercase text-red-400';
                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse';
                
                if (perc > 50) batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-yellow-500';
                else if (perc > 20) batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-orange-500';
                else batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-red-600 animate-pulse';
                
                if(bmsIndicatorMaterial) bmsIndicatorMaterial.color.setHex(0xff0000);
            } else {
                statusText.innerText = 'สแตนด์บาย';
                statusText.className = 'text-xs font-bold tracking-wider uppercase text-blue-400';
                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-blue-500 shadow-[0_0_8px_#3b82f6]';
                
                if (perc < 20) batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-red-500';
                else batteryFill.className = 'h-full rounded-full relative overflow-hidden bg-brand';
                
                if(bmsIndicatorMaterial) bmsIndicatorMaterial.color.setHex(0x00d2ff);
            }
        }

        document.getElementById('btn-charge').addEventListener('click', () => {
            if(batterySim.currentCapacity < batterySim.maxCapacity) batterySim.state = 'charging';
        });
        document.getElementById('btn-discharge').addEventListener('click', () => {
            if(batterySim.currentCapacity > 0) batterySim.state = 'discharging';
        });
        document.getElementById('btn-stop').addEventListener('click', () => {
            batterySim.state = 'idle';
        });

        setInterval(() => { batterySim.tick(); }, 100);

        /**
         * 3. THREE.JS 3D VISUALIZATION
         */
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();

        // Camera setup based on container size
        const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
        camera.position.set(10, 6, 12); // Slightly lower angle for product view

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // Controls
        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxDistance = 25;
        controls.minDistance = 5;
        controls.target.set(0, 3, 0); 
        // Important: Disable panning to prevent scrolling issues on mobile when touching outside model
        // controls.enablePan = false;

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
        dirLight.position.set(10, 20, 10);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 1024;
        dirLight.shadow.mapSize.height = 1024;
        scene.add(dirLight);

        const blueLight = new THREE.PointLight(0x00d2ff, 1.5, 20);
        blueLight.position.set(-5, 5, 5);
        scene.add(blueLight);

        // --- Model Construction ---
        const batteryPack = new THREE.Group();
        
        const cellGeometry = new THREE.CylinderGeometry(0.9, 0.9, 6.5, 32);
        const cellMaterial = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, metalness: 0.9, roughness: 0.2 });

        const cell1 = new THREE.Mesh(cellGeometry, cellMaterial);
        cell1.position.set(-0.92, 3.25, 0);
        cell1.castShadow = true;
        batteryPack.add(cell1);

        const cell2 = new THREE.Mesh(cellGeometry, cellMaterial);
        cell2.position.set(0.92, 3.25, 0);
        cell2.castShadow = true;
        batteryPack.add(cell2);
        
        const capGeometry = new THREE.CylinderGeometry(0.4, 0.4, 0.2, 16);
        const posCap1 = new THREE.Mesh(capGeometry, cellMaterial);
        posCap1.position.set(-0.92, 6.6, 0);
        batteryPack.add(posCap1);
        
        const posCap2 = new THREE.Mesh(capGeometry, cellMaterial);
        posCap2.position.set(0.92, 6.6, 0);
        batteryPack.add(posCap2);

        // Shrink Wrap (Blue)
        const wrapGeometry = new THREE.BoxGeometry(3.8, 6.7, 1.95);
        const wrapMaterial = new THREE.MeshPhysicalMaterial({
            color: 0x0066ff,
            transparent: true,
            opacity: 0.85,
            roughness: 0.3,
            transmission: 0.2,
            thickness: 0.1
        });
        const shrinkWrap = new THREE.Mesh(wrapGeometry, wrapMaterial);
        shrinkWrap.position.set(0, 3.25, 0);
        
        const edgeGeomLeft = new THREE.CylinderGeometry(0.95, 0.95, 6.7, 32);
        const edgeLeft = new THREE.Mesh(edgeGeomLeft, wrapMaterial);
        edgeLeft.position.set(-0.95, 3.25, 0);
        batteryPack.add(edgeLeft);
        
        const edgeGeomRight = new THREE.CylinderGeometry(0.95, 0.95, 6.7, 32);
        const edgeRight = new THREE.Mesh(edgeGeomRight, wrapMaterial);
        edgeRight.position.set(0.95, 3.25, 0);
        batteryPack.add(edgeRight);

        const centerBlockGeom = new THREE.BoxGeometry(1.9, 6.7, 1.9);
        const centerBlock = new THREE.Mesh(centerBlockGeom, wrapMaterial);
        centerBlock.position.set(0, 3.25, 0);
        batteryPack.add(centerBlock);

        // BMS PCB
        const bmsGeometry = new THREE.BoxGeometry(3.4, 0.15, 1.4);
        const bmsMaterial = new THREE.MeshStandardMaterial({ color: 0x002200, roughness: 0.8 }); 
        const bmsBoard = new THREE.Mesh(bmsGeometry, bmsMaterial);
        bmsBoard.position.set(0, 6.75, 0);
        batteryPack.add(bmsBoard);

        // BMS LED
        const bmsIndicatorGeom = new THREE.BoxGeometry(0.2, 0.2, 0.2);
        bmsIndicatorMaterial = new THREE.MeshBasicMaterial({ color: 0x00d2ff }); 
        const bmsIndicator = new THREE.Mesh(bmsIndicatorGeom, bmsIndicatorMaterial);
        bmsIndicator.position.set(1.4, 6.85, 0.4);
        batteryPack.add(bmsIndicator);

        // Wires
        const redCurve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(1, 6.8, 0),
            new THREE.Vector3(1, 7.5, 0.5),
            new THREE.Vector3(2, 8.5, 1.5),
            new THREE.Vector3(3.5, 8.0, 2)
        ]);
        const wireGeometry = new THREE.TubeGeometry(redCurve, 20, 0.08, 8, false);
        const redMaterial = new THREE.MeshStandardMaterial({ color: 0xcc0000, roughness: 0.4 });
        const redWire = new THREE.Mesh(wireGeometry, redMaterial);
        batteryPack.add(redWire);

        const blackCurve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(-1, 6.8, 0),
            new THREE.Vector3(-1, 7.5, -0.5),
            new THREE.Vector3(1, 8.5, 1),
            new THREE.Vector3(3.5, 8.0, 1.7)
        ]);
        const blackGeometry = new THREE.TubeGeometry(blackCurve, 20, 0.08, 8, false);
        const blackMaterial = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.4 });
        const blackWire = new THREE.Mesh(blackGeometry, blackMaterial);
        batteryPack.add(blackWire);

        // JST Connector
        const connectorGeom = new THREE.BoxGeometry(0.8, 0.4, 0.7);
        const connectorMat = new THREE.MeshStandardMaterial({ color: 0xdd0000, roughness: 0.7 });
        const connector = new THREE.Mesh(connectorGeom, connectorMat);
        connector.position.set(3.7, 7.95, 1.85);
        connector.rotation.z = -Math.PI / 8;
        connector.rotation.y = -Math.PI / 16;
        batteryPack.add(connector);

        scene.add(batteryPack);

        // Styling the floor environment specifically for Darayar
        const gridHelper = new THREE.GridHelper(30, 30, 0x00d2ff, 0x334155);
        gridHelper.position.y = -0.01;
        gridHelper.material.opacity = 0.15;
        gridHelper.material.transparent = true;
        scene.add(gridHelper);

        const floorGeometry = new THREE.PlaneGeometry(30, 30);
        const floorMaterial = new THREE.MeshStandardMaterial({ 
            color: 0x0f172a, // Matches Tailwind dark-bg
            roughness: 0.4, 
            metalness: 0.1 
        });
        const floor = new THREE.Mesh(floorGeometry, floorMaterial);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        scene.add(floor);

        // Handle Resize specific to container
        window.addEventListener('resize', onWindowResize, false);
        function onWindowResize() {
            if(!container) return;
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        let autoRotate = true;
        
        container.addEventListener('mousedown', () => autoRotate = false);
        container.addEventListener('touchstart', () => autoRotate = false, {passive: true});

        window.onload = function() {
            updateUI(); 
            
            function animate() {
                requestAnimationFrame(animate);

                if (autoRotate) {
                    batteryPack.rotation.y += 0.0025;
                    batteryPack.position.y = Math.sin(Date.now() * 0.0015) * 0.15; 
                } else {
                    batteryPack.position.y += (0 - batteryPack.position.y) * 0.1;
                }
                
                if (batterySim.state === 'discharging') {
                    batteryPack.position.x = (Math.random() - 0.5) * 0.04;
                    batteryPack.position.z = (Math.random() - 0.5) * 0.04;
                } else {
                    batteryPack.position.x += (0 - batteryPack.position.x) * 0.1;
                    batteryPack.position.z += (0 - batteryPack.position.z) * 0.1;
                }

                controls.update();
                renderer.render(scene, camera);
            }
            
            animate();
        };
    </script>
</body>
</html>
